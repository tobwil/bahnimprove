{
  "name": "bahnimprove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pixel-Leitstand f\u00fcr den deutschen Fernverkehr \u2013 Live-Karte, Versp\u00e4tungen, Tagesbericht mit Dispositionsvorschl\u00e4gen",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"for (const d of ['dist/data/rv','dist/data/realtime']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/build-timetable.ts && tsx scripts/build-map.ts",
    "realtime": "tsx scripts/collect-realtime.ts"
  },
  "devDependencies": {
    "@netlify/functions": "2.8.2",
    "@types/node": "22.9.0",
    "@types/topojson-client": "3.1.5",
    "topojson-client": "3.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@netlify/blobs": "8.1.0",
    "fflate": "0.8.2",
    "gtfs-realtime-bindings": "1.1.1"
  }
}
